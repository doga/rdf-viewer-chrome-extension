{
  "manifest_version": 3,
  "name"            : "__MSG_extension_name__",
  "description"     : "__MSG_extension_description__",
  "version"         : "1.10",
  "default_locale"  : "en",
  "content_scripts" : [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file://*/*"
      ],
      "js": ["content.js"],
      "css": ["assets/styles/extension-styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background"      : {
    "service_worker": "background.js",
    "type"          : "module"
  },
  "icons": {
    "16" : "/assets/images/icons/alpha/semantic-web-logo-16px-alpha.png",
    "32" : "/assets/images/icons/alpha/semantic-web-logo-32px-alpha.png",
    "48" : "/assets/images/icons/alpha/semantic-web-logo-48px-alpha.png",
    "128": "/assets/images/icons/alpha/semantic-web-logo-128px-alpha.png"
  },
  "host_permissions"         : [ "https://vocab.qworum.net/*" ]
}
